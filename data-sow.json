  "modules": [
    {
      "name": "Space Tech Education",
      "icon": "🚀",
      "description": "Hands-on space technology equipment, rocketry models and remote sensing demonstrations that connect students to India's space missions."
    },
    {
      "name": "Robotics Station",
      "icon": "🤖",
      "description": "A robotics station with real-world applications where students build, program and experiment with robots."
    },
    {
      "name": "Water Testing Station",
      "icon": "💧",
      "description": "Field water-quality testing kits that let students analyse local water sources and link science to community health."
    },
    {
      "name": "Sustainability Models",
      "icon": "🌱",
      "description": "Interactive sustainability education models on energy, environment and climate, rooted in local challenges."
    }
  ],
  "objectives": [
    "Increase student engagement and interest in robotics, space knowledge, environmental science and sustainability, specifically in rural and remote areas",
    "Have students identify the role of science in addressing local challenges",
    "Promote global scientific awareness",
    "Enhance students' scientific skills through hands-on activities"
  ],
